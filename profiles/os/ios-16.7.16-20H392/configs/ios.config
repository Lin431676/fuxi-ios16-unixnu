# iOS 16.7.16 (Darwin 22.6.0) userland assumptions, applied before the device defconfig.
#
# The 16.7.16 userland brings its own static trust cache and the sandbox kext is
# prelinked into the kernel, so the runtime trust cache path and the CS hash cache are
# required. Crypto comes from the prelinked closure in the sheng-derived images; fuxi
# overrides this to "source" in its own defconfig.
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
